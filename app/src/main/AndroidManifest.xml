<?xml version="1.0" encoding="utf-8"?>
<!-- WatchCat：权限管理/审计工具（复刻权限狗的功能基线，适配 Android 11–17）。
     权限声明说明：
       QUERY_ALL_PACKAGES —— 应用列表必须能列出全部已装应用（Android 11 起包可见性默认收紧）。
       CAMERA / POST_NOTIFICATIONS / SYSTEM_ALERT_WINDOW —— 仅作「自有靶子」，
         用于在本应用身上闭环验证权限通道（pm revoke → 回读 granted → pm grant），
         不参与产品功能：不调相机、不发通知、不画悬浮窗。别顺手删。
     不联网、不上传、不引入统计 SDK。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".WatchCatApp"
        android:label="WatchCat"
        android:description="@string/app_description"
        android:icon="@drawable/ic_watchcat"
        android:hasCode="true"
        android:allowBackup="false"
        android:supportsRtl="false"
        android:theme="@style/Theme.WatchCat">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="WatchCat"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|uiMode"
            android:theme="@style/Theme.WatchCat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
